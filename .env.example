# ---------------------------------------------------------------------------
# agre-e · environment
# Copy to .env.local for development. Never commit real values.
#
# Leave the Supabase block empty to run the console against the seeded demo
# dataset (every screen shows a DEMO badge). Fill it in to run against a real
# project — the app switches backend automatically and refuses to fall back to
# demo data in a production build.
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Project URL and anon key may be exposed to the browser; the service-role key
# must NOT be. Never prefix it with NEXT_PUBLIC_ (Build Guide §8).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Console security ---------------------------------------------------------
# HMAC pepper for pseudonymising IP addresses (ip_hash). Required in production:
# without it the app refuses to boot rather than writing raw addresses.
IP_HASH_PEPPER=change-me-to-32-random-bytes

# Minutes a step-up verification stays valid for sensitive actions.
ADMIN_STEP_UP_WINDOW_MINUTES=15

# Absolute console session lifetime.
SESSION_ABSOLUTE_HOURS=12

# Canonical URL of the app (used for recovery links and payment redirects).
APP_URL=http://localhost:3000

# Set to 1 ONLY to run the console on demo data in a production build.
# AGREE_E_DEMO=1

# Demo-only autologin for walkthroughs and screenshots (email or seeded id).
# Ignored entirely when Supabase credentials are present.
# AGREE_E_AUTOLOGIN=brian.otieno@agree-e.com

# --- M-PESA Daraja (Lipa na M-PESA / STK push) --------------------------------
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # sandbox test shortcode
MPESA_PASSKEY=                         # Daraja > Lipa Na M-Pesa > Simulate
MPESA_CALLBACK_URL=https://admin.agre-e.com/api/webhooks/mpesa
# Daraja does not sign callbacks. This token is checked on every callback; any
# callback without it is rejected and recorded as a security event.
MPESA_CALLBACK_TOKEN=

# --- Flutterwave (card, bank transfer, USSD, mobile money) --------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Must match the "secret hash" configured in the Flutterwave dashboard under
# Settings > Webhooks. Unsigned webhook POSTs are discarded with 401.
FLW_SECRET_HASH=
FLW_WEBHOOK_PATH=/api/webhooks/flutterwave
